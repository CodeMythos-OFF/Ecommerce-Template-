# Optional API override. Leave unset in production to use the same-origin Vercel /api rewrite.
# Local development:
VITE_API_URL=http://localhost:5000/api
# For a separately hosted backend, use its full API base URL ending in /api:
# VITE_API_URL=https://your-backend.example.com/api

# Optional public Google OAuth client ID. Must exactly match server GOOGLE_CLIENT_ID.
# If unset, the app uses the repository's configured default client ID.
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Backend-only values belong in server/.env and the backend hosting provider's environment settings.
# MONGODB_URI=your_mongodb_connection_string
# AUTH_SESSION_SECRET=generate_a_random_secret_of_at_least_32_characters
