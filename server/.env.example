# MongoDB
MONGODB_URI=your_mongodb_connection_string

# Server
PORT=5000
NODE_ENV=production

# Google OAuth / Sign in with Google
# Client ID is public and is also configured in the frontend.
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Secret used to sign ShopMaster's HttpOnly login session cookie.
# Use a random value of at least 32 characters and keep it ONLY in Vercel/server environment variables.
AUTH_SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters
